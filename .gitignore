# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Raw downloaded filings (762MB — regenerated by scripts/fetch_filings.py
# from data/manifest.json's pinned accession numbers). The manifest and the
# derived extraction outputs (chunks/tables/facts/chart descriptions) ARE
# tracked — they're real artifacts, not raw scrape output, and the chart
# descriptions specifically cost real rate-limited Gemini API calls
# (20/day quota) to produce, so they're worth keeping even though they're
# technically regeneratable.
data/filings/

# Model weights/caches downloaded at runtime
.cache/
*.pt
*.safetensors

# Fine-tuned checkpoints. `scripts/finetune_biencoder.py --out` writes here,
# and config/profiles/finetuned.yaml names the path. The weights are not
# tracked (see the model card, #25): a checkpoint is ~130MB of derived
# output. Once a training run happens, the claim will rest on the training
# script, the tracked sample splits, the hosted run and
# results/training/report.json — none of which exist yet, because no run has
# completed. Anchored to the repository root so it cannot silently swallow a
# `models/` directory somewhere else in the tree.
/models/

# Docker / local OpenSearch data volume
docker/opensearch-data/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/tfplan
terraform/*.tfvars
!terraform/*.tfvars.example

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Secrets — never commit API keys
.env

# Experiment-tracking run directories. Local mirrors of runs that live on
# Weights & Biases — the hosted run is the artifact worth citing (it is
# third-party and cannot be edited after the fact), and committed
# debug-internal.log files read as a repository nobody is curating.
wandb/

# Local working notes for the coding-assistant session. They stay on this
# machine: the engineering findings that matter to a reader live in
# docs/engineering-notes.md and docs/adr/, written to be read.
CLAUDE.md
docs/agents/
.claude/
