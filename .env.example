# Copy to .env (gitignored) and fill in your own key.
# Free, no card required: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: experiment tracking. Without this, eval scripts still run and
# still write their report files — they just do not log a tracked run.
# Get one at https://wandb.ai/authorize
WANDB_API_KEY=
